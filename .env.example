# ===== 数据库 =====
ASYNC_DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/rag_demo?charset=utf8
# 是否输出 SQL 日志（调试用），true 可查看 SQLAlchemy 打印的 SQL
DB_ECHO=false

# ===== 依赖服务口令（docker compose 生产安全版必需）=====
# compose 会自动读取本 .env 做变量替换；数据服务端口只绑定 127.0.0.1，
# 口令缺失时 compose 会拒绝启动（fail-closed）。若用旧版默认口令（root/root、无 Redis 口令）
# 部署到公网服务器，数据库/缓存会被直接扫描连接，务必改为强口令。
MYSQL_PASSWORD=change-me-to-a-strong-mysql-password
POSTGRES_PASSWORD=change-me-to-a-strong-postgres-password
REDIS_PASSWORD=change-me-to-a-strong-redis-password
# POSTGRES_USER=rag   # Postgres 用户名，默认 rag（非 root）

# ===== SiliconFlow（Embedding + Rerank，必需）=====
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=your_siliconflow_api_key
# 精排分阈值：低于此值的候选丢弃（默认 0.3）
RERANK_SCORE_THRESHOLD=0.3

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
# docker compose 版已开启 Milvus 认证；容器内连接串由 compose 覆盖为
# http://root:Milvus@milvus:19530（可经 MILVUS_USERNAME/MILVUS_PASSWORD 覆盖；
# 改密需同时改 docker/milvus.yaml 的 authorization 配置）
# MILVUS_USERNAME=root
# MILVUS_PASSWORD=Milvus

# ===== MinIO（Milvus 依赖，仅容器内网；建议 .env 覆盖默认口令）=====
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# ===== MinerU（复杂 Word/PDF 解析 Token，必需）=====
MINERU_API_TOKEN=your_mineru_token
# 提交/上传请求超时（秒）：避免服务端挂起时 worker 线程无限阻塞（默认 30s / 300s）
# MINERU_SUBMIT_TIMEOUT=30
# MINERU_UPLOAD_TIMEOUT=300
# 解析产物 zip 解压防护（zip-slip / 解压炸弹）：成员数上限与解压后总大小上限（字节）
# MINERU_ZIP_MAX_MEMBERS=2000
# MINERU_ZIP_MAX_UNCOMPRESSED_BYTES=209715200

# ===== DeepSeek（RAG 问答生成，可选）=====
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 以下为预留/可选（当前版本未使用）=====
TAVILY_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.LangChain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="rag-project"
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# ===== 认证（JWT + 管理员播种）=====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 登录/注册限流：60 秒窗口内最大失败次数（Redis ZSET 滑动窗口，不可用时回退进程内）
LOGIN_MAX_ATTEMPTS=5
# 登录硬锁只按 IP（跨用户名共享）：防止攻击者跨 IP 定向锁死指定用户名；
# 按「用户名+IP」的失败计数保留作记录，但不作为硬锁依据（默认 20 次/60s）
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# Redis 宕机期间进程内限流 dict 的 key 上限（防内存无限增长），默认 10000
# MAX_LOCAL_ATTEMPTS_KEYS=10000
# 环境标识：production/prod 时关闭 Swagger /docs 与 /openapi.json 暴露
# APP_ENV=development
# 或直接 DISABLE_DOCS=true 关闭文档（默认开启，供开发调试）
# DISABLE_DOCS=false
# 上传内容嗅探（M5）：docx zip 解压防护——成员数上限 / 解压后总大小上限（字节）
# DOCX_MAX_MEMBERS=10000
# DOCX_MAX_UNCOMPRESSED_BYTES=524288000
# 反向代理（Nginx/Caddy）后设为 true：客户端 IP 取 X-Forwarded-For 最右一段
# （由可信代理追加），否则限流按代理 IP 计数会全站互相误伤。仅在可信代理后开启。
TRUST_PROXY_HEADERS=false
# 成本限流（滑动窗口 60s/用户；0 或负数表示不限流）：
# 问答触发 analyze+检索+rerank+生成（一次最多 5 子问题），是最贵的接口；检索次之
CHAT_MAX_REQUESTS_PER_MINUTE=10
SEARCH_MAX_REQUESTS_PER_MINUTE=30
# 注册开关：生产默认关闭。开启后同一 IP 每分钟最多成功/失败合计 5 次注册请求
REGISTRATION_ENABLED=false
REGISTER_MAX_REQUESTS_PER_MINUTE=5
# 上传批次限流（滑动窗口 3600s/用户；一次批量最多 MAX_BATCH_UPLOAD 个文件）
UPLOAD_MAX_REQUESTS_PER_HOUR=30
# rag_traces 保留天数；0/负数表示永久保留
TRACE_RETENTION_DAYS=30
# SSE 心跳间隔（秒）
SSE_HEARTBEAT_SECONDS=15
# 会话级锁：生成与删除互斥；TTL 秒（默认 1800）/ 获取等待秒数（默认 0）
# SESSION_OPERATION_LOCK_TTL=1800
# SESSION_OPERATION_LOCK_WAIT=0

# ===== 对话记忆（Postgres，Docker 部署后填写）=====
# MEMORY_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_memory
# 长连接默认自动追加 TCP keepalive（keepalives_idle=30 等）；URL 里显式配置的项不会被覆盖
# 会话记忆 TTL（天）：按 chat_sessions.updated_at 计算，超过该天数未活跃的会话
# 会被后台任务清理（连同 Postgres checkpoint 记忆），默认 1 天 = 24 小时
MEMORY_TTL_DAYS=1
# 清理任务执行间隔（分钟），默认 60
MEMORY_CLEANUP_INTERVAL_MINUTES=60
# 记忆 Postgres 连接池大小（断线自愈用；PostgresSaver 自带线程锁串行化操作）：
# min 初始连接数 / max 最大连接数（断线重建留余量），默认 1 / 4
# MEMORY_POOL_MIN_SIZE=1
# MEMORY_POOL_MAX_SIZE=4

# ===== LLM 计费（预估费用单价，元 / 每百万 token）=====
# 每次 LLM 调用写入 llm_usage：estimated_cost = 未命中缓存输入*input + 命中缓存输入*cached + 输出*output，再除以 1e6
# DeepSeek 主模型（deepseek-v4-flash）
DEEPSEEK_PRICE_INPUT=2.0        # 未命中缓存输入单价
DEEPSEEK_PRICE_CACHED=0.5       # 命中缓存输入单价
DEEPSEEK_PRICE_OUTPUT=8.0       # 输出单价
# 降级模型 Qwen（qwen3.7-flash）
QWEN_PRICE_INPUT=1.0
QWEN_PRICE_CACHED=0.2
QWEN_PRICE_OUTPUT=2.0
# 未知模型回退单价（默认同 DeepSeek）
# DEFAULT_LLM_PRICE_INPUT=2.0
# DEFAULT_LLM_PRICE_CACHED=0.5
# DEFAULT_LLM_PRICE_OUTPUT=8.0

# ===== 模型（采样温度 + DeepSeek 故障降级）=====
# 采样温度：主模型与降级模型统一使用（默认 0.7）
MODEL_TEMPERATURE=0.7
# DeepSeek 不可用时的降级模型：DashScope 千问，
# 走下方 DASHSCOPE_BASE_URL / DASHSCOPE_API_KEY（OpenAI 兼容端点）
QWEN_MODEL=qwen3.7-flash

# ===== 分层检索（Parent-Child，推荐开启）=====
# 开启前需先建 parent_chunks 表（models/vector.sql §8）；设计见 docs/PARENT_CHILD_RETRIEVAL_DESIGN.md
# 评测结论（evaluation/eval_onoff_report.md）：开启后 hit@1/hit@3 与单层持平(91%/100%)、
# 上下文完整度 +73%（命中点动态开窗）、token 成本可控 → 推荐默认开启。
# 代码默认 false（向后兼容：存量单层数据与旧行为不受影响）；本机 .env 已开启。
RAG_PARENT_CHILD=false
# 子块大小/重叠；父块封顶；命中点向前/向后扩展（字符，实验推荐 fwd=500）
# CHILD_CHUNK_SIZE=250
# CHILD_OVERLAP=30
# PARENT_MAX_CHARS=2000
# BACK_EXPAND_CHARS=200
# FWD_EXPAND_CHARS=500
# 跨 Parent 合并触发：窗口贴近父块边界的字符阈值（A 贴近末尾 且 B 贴近开头）
# PARENT_BOUNDARY_MARGIN=100
# 最终上下文 Token 预算（估算，软上限）/ 最小上下文保护 / 字符→token 折算（仅检索预算，非计费）
# CONTEXT_MAX_TOKENS=1200
# CONTEXT_MIN_TOKENS=300
# EST_CHARS_PER_TOKEN=1.6
# 父块 Redis 缓存 TTL（秒）
# PARENT_CACHE_TTL=600

# ===== Redis（入库任务队列 / 限流计数 / 缓存）=====
# REDIS_URL=redis://localhost:6379/0
# 入库/删除队列崩溃恢复阈值（毫秒）：必须大于单任务最长处理耗时，
# 避免把仍在处理中的任务误判为崩溃残留而抢占（默认 10 分钟）
# INGEST_RECOVER_IDLE_MS=600000
# DELETE_RECOVER_IDLE_MS=600000
# 账号删除宽限期（天）：提交删除后账号立即锁定、公开文档即刻下架，
# 到期后由删除队列彻底清除（Milvus/OSS/本地/MySQL/对话记忆）；默认 7 天
# DELETE_GRACE_DAYS=7
# 缓存 TTL（秒）：embedding 默认 7 天 / 检索结果默认 10 分钟 / 回答默认 1 小时
# EMBEDDING_CACHE_TTL=604800
# SEARCH_CACHE_TTL=600
# ANSWER_CACHE_TTL=3600

# ===== 上传目录（默认 rag个人知识库/resources/uploads）=====
# UPLOAD_DIR=

# ===== 文档原件归档（阿里云 OSS，可选）=====
# 上传的原始文档默认落到本地 upload/ 作为临时中转；入库成功后归档到 OSS 再删本地原件。
# 不配置则保持本地保留（不删原件），不影响功能。
# OSS_ENABLE=false
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET=your-bucket-name
# 下载 URL：公有读桶填 https://{bucket}.{endpoint} 或 CDN 域名；私有桶留空（走签名 URL）
# OSS_PUBLIC_BASE=
# OSS 对象 key 前缀：上传到 bucket 下 rag-project/ 目录（OSS key = 前缀 + uploads/{uid}/file）
# OSS_KEY_PREFIX=rag-project/
